{
  ":neq ": ["Not equal.", "a \\neq b"],
  ":leq ": ["Less than or equal.", "a \\leq b"],
  ":geq ": ["Greater than or equal.", "a \\geq b"],
  ":ll ": ["Much less than.", "\\varepsilon \\ll 1"],
  ":gg ": ["Much greater than.", "n \\gg 0"],
  ":approx ": ["Approximately equal.", "\\pi \\approx 3.14159"],
  ":sim ": ["Similar to, or distributed as.", "X \\sim \\mathcal{N}(0, 1)"],
  ":simeq ": ["Asymptotically or homotopically equivalent.", "a_n \\simeq b_n"],
  ":cong ": ["Isomorphic or congruent.", "G \\cong H"],
  ":equiv ": ["Identically equal, or congruent modulo n.", "a \\equiv b \\pmod{n}"],
  ":propto ": ["Proportional to.", "F \\propto \\frac{1}{r^2}"],
  ":doteq ": ["Approaches, or is defined to equal.", "x \\doteq y"],
  ":asymp ": ["Asymptotically equivalent up to constants.", "f(n) \\asymp g(n)"],
  ":defeq ": ["Definition — the left side is defined by the right.", "S \\coloneqq \\{ 1, 2, 3 \\}"],
  ":prec ": ["Precedes in a partial order.", "a \\prec b"],
  ":preceq ": ["Precedes or equals in a partial order.", "a \\preceq b"],
  ":succ ": ["Succeeds in a partial order.", "b \\succ a"],
  ":succeq ": ["Succeeds or equals in a partial order.", "b \\succeq a"],
  ":perp ": ["Perpendicular, or orthogonal.", "u \\perp v"],
  ":parallel ": ["Parallel to.", "g \\parallel h"],
  ":nparallel ": ["Not parallel to.", "g \\nparallel h"],
  ":mid ": ["Divides, or the conditioning bar in set-builder notation.", "d \\mid n"],
  ":nmid ": ["Does not divide.", "2 \\nmid 7"]
}
