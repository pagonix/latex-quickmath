{
  ":infty ": ["Infinity.", "\\lim_{n \\to \\infty} a_n"],
  ":lim ": ["Limit with a subscript condition.", "\\lim_{x \\to 0} \\frac{\\sin x}{x} = 1"],
  ":limto ": ["Limit with the arrow already in place.", "\\lim_{n \\to \\infty} \\frac{1}{n} = 0"],
  ":limsup ": ["Limit superior — the largest accumulation point.", "\\limsup_{n \\to \\infty} a_n"],
  ":liminf ": ["Limit inferior — the smallest accumulation point.", "\\liminf_{n \\to \\infty} a_n"],
  ":sup ": ["Supremum — the least upper bound.", "\\sup_{x \\in A} f(x)"],
  ":inf ": ["Infimum — the greatest lower bound.", "\\inf_{x \\in A} f(x)"],
  ":max ": ["Maximum — an attained largest value.", "\\max \\{ a, b \\}"],
  ":min ": ["Minimum — an attained smallest value.", "\\min \\{ a, b \\}"],
  ":argmax ": ["The argument at which a maximum is attained.", "\\operatorname*{arg\\,max}_{x \\in A} f(x)"],
  ":argmin ": ["The argument at which a minimum is attained.", "\\operatorname*{arg\\,min}_{\\theta} L(\\theta)"],
  ":sum ": ["Sum with lower and upper bounds.", "\\sum_{i=1}^{n} a_i"],
  ":sumin ": ["Sum over an index set.", "\\sum_{i \\in I} a_i"],
  ":suminf ": ["Infinite series — the upper bound is already ∞.", "\\sum_{n=0}^{\\infty} \\frac{1}{n!} = e"],
  ":prod ": ["Product with lower and upper bounds.", "\\prod_{i=1}^{n} a_i"],
  ":prodin ": ["Product over an index set.", "\\prod_{p \\in \\mathbb{P}} p"],
  ":int ": ["Definite integral with both limits.", "\\int_{0}^{1} x^2 \\, \\mathrm{d}x"],
  ":intover ": ["Integral over a domain rather than an interval.", "\\int_{\\Omega} f \\, \\mathrm{d}\\mu"],
  ":oint ": ["Contour integral around a closed curve.", "\\oint_{\\gamma} f(z) \\, \\mathrm{d}z"],
  ":iint ": ["Double integral over a region.", "\\iint_{D} f(x, y) \\, \\mathrm{d}A"],
  ":iiint ": ["Triple integral over a volume.", "\\iiint_{V} \\rho \\, \\mathrm{d}V"],
  ":dd ": ["Upright differential d with its thin space.", "\\int f(x) \\, \\mathrm{d}x"],
  ":diff ": ["Ordinary derivative as a fraction.", "\\frac{\\mathrm{d}y}{\\mathrm{d}x}"],
  ":pdiff ": ["Partial derivative as a fraction.", "\\frac{\\partial f}{\\partial x}"],
  ":partial ": ["Partial derivative symbol, also a boundary.", "\\partial \\Omega"],
  ":nabla ": ["Nabla — gradient, divergence, or curl.", "\\nabla f"],
  ":frac ": ["Fraction with numerator and denominator.", "\\frac{a}{b}"],
  ":sqrt ": ["Square root.", "\\sqrt{x^2 + y^2}"],
  ":nsqrt ": ["nth root — the index goes in the brackets.", "\\sqrt[3]{x}"],
  ":binom ": ["Binomial coefficient.", "\\binom{n}{k}"],
  ":exp ": ["Exponential function with parentheses ready.", "\\exp(x + y)"],
  ":ln ": ["Natural logarithm.", "\\ln e = 1"],
  ":log ": ["Logarithm with a subscript base.", "\\log_{2} n"],
  ":sin ": ["Sine.", "\\sin^2 x + \\cos^2 x = 1"],
  ":cos ": ["Cosine.", "\\cos(2x)"],
  ":tan ": ["Tangent.", "\\tan x = \\frac{\\sin x}{\\cos x}"],
  ":bigo ": ["Big-O — an asymptotic upper bound.", "\\mathcal{O}(n \\log n)"],
  ":smallo ": ["Little-o — strictly smaller asymptotic growth.", "\\mathrm{o}(n)"]
}
